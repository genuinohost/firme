{
  "hosting": {
    "target": "firme",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "comment_rewrites": "La app es de una sola página, así que todo va a index.html. Se excluyen los archivos que se descargan: si no, pedir un .apk devolvería el HTML de la app con código 200, y quien lo descargara se bajaría basura sin enterarse.",
    "rewrites": [
      {
        "source": "!/**/*.@(apk|aab|json|png|jpg|svg|webmanifest|js|css|txt|pdf)",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "comment": "El service worker y el manifiesto no se cachean: si no, el móvil se queda con una versión vieja y las alarmas dejan de actualizarse.",
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/sw-avisos.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/manifest.webmanifest",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "comment": "Los recursos llevan huella en el nombre: se pueden cachear para siempre.",
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  }
}
