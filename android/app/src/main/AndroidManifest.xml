<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
          Los dos receptores del despertador. El primero es el que Android
          despierta a la hora, aunque la app lleve dias cerrada. El segundo
          rehace la cola cuando se reinicia el movil, porque al reiniciar
          Android olvida todas las alarmas programadas.
        -->
        <receiver
            android:name=".ReceptorAlarma"
            android:exported="false"
            android:directBootAware="true" />

        <!--
          El que hace ruido. Va en primer plano porque tiene que seguir sonando
          con el movil bloqueado y la app cerrada, y reproduce el tono el mismo
          por el flujo de alarma: asi No molestar no lo silencia.
        -->
        <service
            android:name=".ServicioAlarma"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:directBootAware="true" />

        <!-- Repone las alarmas cada seis horas sin depender de que suene
             ninguna. Ver TrabajoRearmar.java: el 23-09-2026 fallo una alarma y
             se llevo doce por delante porque el rearme dependia del disparo. -->
        <!--
            Mientras hay una sala de voz abierta. El tipo `microphone` es lo que
            impide que Android 14 corte el microfono al pasar a segundo plano.
        -->
        <service
            android:name=".ServicioSala"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".TrabajoRearmar"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <receiver
            android:name=".ReceptorArranque"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!--
      Dictar por voz. Android 11 en adelante esconde las apps de otros salvo que
      se pregunte por ellas: sin este <queries>, isRecognitionAvailable()
      devuelve false aunque el movil sepa transcribir de sobra.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Mostrar los avisos (Android 13+ lo pide al usuario). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      El microfono, para dictar notas y tareas. Se pide al tocar el boton, no al
      arrancar: pedir permisos antes de que se entienda para que son es la forma
      mas rapida de que te los nieguen para siempre.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
        Las salas de voz.

        MODIFY_AUDIO_SETTINGS lo exige el SDK de Agora: sin el no puede cambiar
        al modo de comunicacion ni encender el altavoz, y una llamada suena por
        el auricular con el volumen de multimedia.

        FOREGROUND_SERVICE_MICROPHONE es lo que hace que un devocional de
        cuarenta y cinco minutos no se muera al mirar otra cosa. Desde Android 14
        el sistema **corta el microfono** a una app en segundo plano si no hay un
        servicio en primer plano de tipo microfono. Sin esto, salir de la app un
        segundo te saca de la sala sin decir nada.
    -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!--
      Poner una alarma en el reloj del propio movil, como respaldo de las que de
      verdad no pueden fallar. El reloj es una app del sistema y ninguna capa
      del fabricante lo congela de madrugada; nuestro despertador si.
    -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!--
      Alarmas al minuto exacto. Sin esto Android agrupa los avisos y los
      retrasa hasta que el móvil despierte por su cuenta, que es justo lo que
      hacía inútil la versión web.

      USE_EXACT_ALARM lo concede el sistema sin preguntar, y está reservado a
      apps cuya función principal es despertar o avisar a una hora — que es el
      caso. SCHEDULE_EXACT_ALARM queda como respaldo para Android 12.
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Volver a poner la cola de alarmas después de reiniciar el teléfono. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Abrir la app a pantalla completa cuando suena, con el móvil bloqueado.
      Android lo reserva a despertadores y llamadas, que es justo lo que es.
    -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!--
      El servicio que repica. Tiene que estar en primer plano para que Android
      no lo mate a mitad de la alarma, y reproduce el tono él mismo por el flujo
      de alarma: esa es la única forma de que No molestar no lo silencie.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!--
      Para que «saltar No molestar» del canal de respaldo no sea papel mojado.
      Sin este acceso, setBypassDnd() se ignora en silencio.
    -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Encender la pantalla al sonar, en vez de esperar a que alguien la toque. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />

    <!-- Pedir que el sistema no congele la app, que es lo que mata las alarmas. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
</manifest>
