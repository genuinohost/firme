<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
          Los dos receptores del despertador. El primero es el que Android
          despierta a la hora, aunque la app lleve dias cerrada. El segundo
          rehace la cola cuando se reinicia el movil, porque al reiniciar
          Android olvida todas las alarmas programadas.
        -->
        <receiver
            android:name=".ReceptorAlarma"
            android:exported="false"
            android:directBootAware="true" />

        <!--
          El que hace ruido. Va en primer plano porque tiene que seguir sonando
          con el movil bloqueado y la app cerrada, y reproduce el tono el mismo
          por el flujo de alarma: asi No molestar no lo silencia.
        -->
        <service
            android:name=".ServicioAlarma"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:directBootAware="true" />

        <receiver
            android:name=".ReceptorArranque"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Mostrar los avisos (Android 13+ lo pide al usuario). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Alarmas al minuto exacto. Sin esto Android agrupa los avisos y los
      retrasa hasta que el móvil despierte por su cuenta, que es justo lo que
      hacía inútil la versión web.

      USE_EXACT_ALARM lo concede el sistema sin preguntar, y está reservado a
      apps cuya función principal es despertar o avisar a una hora — que es el
      caso. SCHEDULE_EXACT_ALARM queda como respaldo para Android 12.
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Volver a poner la cola de alarmas después de reiniciar el teléfono. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Abrir la app a pantalla completa cuando suena, con el móvil bloqueado.
      Android lo reserva a despertadores y llamadas, que es justo lo que es.
    -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!--
      El servicio que repica. Tiene que estar en primer plano para que Android
      no lo mate a mitad de la alarma, y reproduce el tono él mismo por el flujo
      de alarma: esa es la única forma de que No molestar no lo silencie.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!--
      Para que «saltar No molestar» del canal de respaldo no sea papel mojado.
      Sin este acceso, setBypassDnd() se ignora en silencio.
    -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Encender la pantalla al sonar, en vez de esperar a que alguien la toque. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />

    <!-- Pedir que el sistema no congele la app, que es lo que mata las alarmas. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
</manifest>
