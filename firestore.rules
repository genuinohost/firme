rules_version = '2';

// ============================================================================
// Las reglas de Genuino.
//
// Esto NO es una capa de adorno sobre la app: es lo único que separa los datos
// de las personas de cualquiera con una conexión a internet. La app cliente se
// puede desmontar y reescribir en una tarde; estas reglas no. Todo lo que aquí
// no se prohíba, está permitido para todo el mundo.
//
// ── La línea, y dónde se movió ────────────────────────────────────────────
//
// Hasta el 17 de septiembre de 2026 aquí ponía que **el diario, las notas y
// los repasos no subían nunca**, y pedía que quien lo cambiara viniera a
// borrar el párrafo a mano. Esto es esa mano.
//
// Lo cambió Alex, el dueño de la app, con estas palabras: «las notas en el
// diario y exámenes deben tener la opción de pública o privada. Lo público lo
// puede ver todo el mundo, amigos o no». Queda escrito aquí, y no sólo en un
// registro de cambios, para que dentro de un año se sepa quién lo pidió.
//
// **La regla nueva:** nada de lo que se escribe llega a este servidor salvo la
// nota concreta en la que su dueño tocó «publicar». Todo nace privado, lo que
// ya estaba escrito sigue privado, y despublicar borra el documento — no lo
// esconde. Ni el plan del que viene una nota ni cómo acabó aquel día se
// publican jamás: eso cuenta la batalla de alguien aunque su texto no la
// cuente.
//
// El diario entero y los repasos de la noche siguen sin tener colección aquí, y
// siguen sin poder tenerla.
//
// ── La segunda vez que se movió: el respaldo ───────────────────────────────
//
// El 24 de septiembre de 2026, Alex: «los datos básicos deberían estar en una
// nube, porque no todo el mundo va a estar pendiente de exportar una copia».
// Tenía razón, y era un fallo de diseño: el primer hermano que cambiara de
// teléfono perdía su rutina entera.
//
// Así que **la rutina y los registros sí suben ahora**, en `usuarios/{uid}/
// respaldo/rutina`, y sólo los lee su dueño. Lo que no sube, y lo que estas
// reglas impiden que suba nunca, está escrito abajo en esa sección.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function haEntrado() {
      return request.auth != null;
    }

    function esElMismo(uid) {
      return haEntrado() && request.auth.uid == uid;
    }

    // Quién puede retirar lo que escribió otro.
    //
    // La lista vive en `moderadores/{uid}` y **no se puede leer ni escribir
    // desde la app**: se pone a mano desde la consola de Firebase. `exists()`
    // funciona igual, porque las reglas no se aplican a sí mismas.
    //
    // Existe porque Google Play no deja publicar una app donde unos usuarios
    // leen lo que escriben otros si nadie puede quitar lo que esté mal.
    // Quien se apuntó a la comunidad de voz. Es la comunidad del devocional:
    // lo que en WhatsApp es el grupo, aquí es esta lista.
    function esMiembro() {
      return haEntrado()
        && exists(/databases/$(database)/documents/comunidad/voz/miembros/$(request.auth.uid));
    }

    function esModerador() {
      return haEntrado()
        && exists(/databases/$(database)/documents/moderadores/$(request.auth.uid));
    }

    // Un perfil que no cabe en esto es un perfil que trae basura o un intento
    // de usar la base como almacén ajeno.
    function perfilRazonable(d) {
      return d.nombre is string && d.nombre.size() >= 2 && d.nombre.size() <= 40
        && d.usuario is string && d.usuario.size() >= 3 && d.usuario.size() <= 20
        && d.usuario.matches('^[a-z0-9._]+$')
        && (!('ciudad' in d) || (d.ciudad is string && d.ciudad.size() <= 60))
        && (!('pais' in d) || (d.pais is string && d.pais.size() <= 60))
        && (!('versiculo' in d) || (d.versiculo is string && d.versiculo.size() <= 300))
        && (!('cita' in d) || (d.cita is string && d.cita.size() <= 60))
        // La foto va **dentro del perfil**, encogida a 192 píxeles: unos diez
        // kilobytes. Así no hace falta montar un almacén de archivos, ni
        // pagarlo, ni escribir reglas para él, ni acordarse de borrar la foto
        // cuando alguien borra su cuenta — se va con el perfil, porque es el
        // perfil. El tope deja sitio de sobra para eso y muy poco para que a
        // nadie se le ocurra usar esto como disco duro.
        && (!('foto' in d) || (d.foto is string && d.foto.size() <= 60000))
        // Las cifras que cada uno decide enseñar a sus hermanos. Se validan
        // como números y con un techo: no para desconfiar de la app, sino
        // porque **estas reglas son lo único que sigue en pie si alguien no
        // usa la app** y escribe contra la base directamente.
        && (!('muestraRachas' in d) || d.muestraRachas is bool)
        && (!('racha' in d) || (d.racha is int && d.racha >= 0 && d.racha <= 100000))
        && (!('diasEnPie' in d) || (d.diasEnPie is int && d.diasEnPie >= 0 && d.diasEnPie <= 100000))
        && (!('cumplidos' in d) || (d.cumplidos is int && d.cumplidos >= 0 && d.cumplidos <= 10000000))
        // El nombre en minúsculas, sólo para poder buscar.
        && (!('busca' in d) || (d.busca is string && d.busca.size() <= 60));
    }

    // ------------------------------------------------------------- perfiles
    //
    // Un perfil lo puede leer cualquiera que haya entrado: si no, no habría
    // forma de buscar a un hermano por su nombre de usuario para agregarlo.
    // Por eso **en el perfil no va nada que no se pueda enseñar**: ni correo,
    // ni dirección, ni nada de lo que se escribe en la app.
    match /usuarios/{uid} {
      allow read: if haEntrado();
      allow create, update: if esElMismo(uid) && perfilRazonable(request.resource.data);
      allow delete: if esElMismo(uid);

      // ------------------------------------------- lo que sólo ven los suyos
      //
      // **El WhatsApp no va en el perfil.** El perfil lo puede leer cualquiera
      // que haya entrado —hace falta para poder buscar a un hermano por su
      // nombre—, y un número de teléfono ahí lo recoge cualquiera con una
      // cuenta y un rato libre.
      //
      // Así que vive aparte, y aquí se comprueba de verdad que quien lo pide es
      // un hermano **ya aceptado**: se mira en la lista de amigos del dueño si
      // existe el documento de quien pregunta y si está en «aceptada». Cuesta
      // una lectura más, y es exactamente lo que hay que pagar por esto.
      match /privado/{cual} {
        allow read: if esElMismo(uid)
          || (
            haEntrado()
            && exists(/databases/$(database)/documents/usuarios/$(uid)/amigos/$(request.auth.uid))
            && get(/databases/$(database)/documents/usuarios/$(uid)/amigos/$(request.auth.uid)).data.estado == 'aceptada'
          );
        allow write: if esElMismo(uid)
          && (!('whatsapp' in request.resource.data)
              || (request.resource.data.whatsapp is string
                  && request.resource.data.whatsapp.size() <= 40));
      }

      // ----------------------------------------------------------- el respaldo
      //
      // La copia de la rutina, para que cambiar de teléfono no cueste la racha.
      //
      // **Sólo su dueño.** Ni los hermanos aceptados, que sí pueden leer
      // `privado`: ahí hay un número de teléfono para que le llamen, y aquí hay
      // el respaldo de alguien. No es un dato de su perfil, no se comparte con
      // nadie, y por eso la condición es la más corta de este archivo.
      //
      // **La lista de campos es la promesa, escrita donde se cumple.** El
      // diario (`notas`) no está en la lista, así que no cabe: no depende de
      // que la app se acuerde de quitarlo, ni de que nadie meta mañana otra vía
      // de subida. Si un día alguien intenta respaldar el diario, esto se lo
      // niega en el servidor.
      //
      // Lo que estas reglas **no** pueden vigilar es lo que va dentro de
      // `registros` y `planesRegistros`: las reglas no saben recorrer un mapa.
      // Que la excusa de cada día y las áreas donde alguien cayó se queden en
      // el móvil lo decide `src/logica/respaldoNube.ts`, en un solo sitio y a
      // propósito. Aquí queda dicho para que se sepa dónde mirar.
      match /respaldo/{cual} {
        allow read: if esElMismo(uid);
        allow write: if esElMismo(uid)
          && request.resource.data.keys().hasOnly([
            'version', 'planes', 'planesRegistros', 'rutina', 'tareas',
            'registros', 'motivos', 'ajustes', 'guardado'
          ])
          && request.resource.data.guardado is number;
      }

      // --------------------------------------------------------- bloqueados
      //
      // A quién no quiero volver a leer. Es asunto de uno y de nadie más: ni
      // siquiera el bloqueado puede saber que lo está, que es justo lo que
      // hace que bloquear no dé miedo.
      match /bloqueados/{otro} {
        allow read, write: if esElMismo(uid);
      }

      // --------------------------------------------------------- amistades
      //
      // Cada lado guarda su propia copia. Parece redundante y no lo es: es lo
      // que permite que las reglas sean simples y que nadie pueda escribir en
      // la lista de otro salvo para una cosa muy concreta — dejar ahí una
      // solicitud **a nombre de sí mismo**.
      //
      // Sin esa restricción, cualquiera podría meterse en la lista de amigos
      // de cualquiera, o borrar las amistades de otro.
      match /amigos/{otro} {
        allow read: if esElMismo(uid);
        allow write: if esElMismo(uid);

        // Mandar una solicitud: escribir en la bandeja del otro, pero solo un
        // documento que habla de uno mismo y en estado «recibida».
        allow create: if esElMismo(otro)
          && request.resource.data.estado == 'recibida'
          && request.resource.data.keys().hasOnly(['estado', 'cuando', 'nombre', 'usuario', 'foto']);

        // Aceptar: el otro marca como aceptada la copia que tiene el primero.
        allow update: if esElMismo(otro)
          && request.resource.data.estado == 'aceptada'
          && resource.data.estado == 'enviada';

        // Deshacer una solicitud propia, o borrarse de la lista de alguien a
        // quien uno ya no quiere tener. Siempre sobre el documento de uno.
        allow delete: if esElMismo(otro);
      }
    }

    // ---------------------------------------------------------------- las salas
    //
    // El devocional en voz, y la llamada de dos. Son lo mismo con dos tamaños,
    // así que hay una sola colección.
    //
    // ── Aquí no viaja audio ───────────────────────────────────────────────
    //
    // Firestore sólo guarda **quién está dentro y quién tiene la palabra**. La
    // voz va por el SFU de Agora y no pasa por aquí ni queda grabada en ningún
    // sitio. Lo que hay en estos documentos es una lista de nombres.
    //
    // ── La regla que sostiene el devocional ───────────────────────────────
    //
    // **Nadie se da la palabra a sí mismo.** Treinta micrófonos abiertos no son
    // un devocional, son un ruido; así que se entra en silencio, se levanta la
    // mano, y el anfitrión da la palabra.
    //
    // Y eso **se cumple aquí, no por educación**: al actualizar su propio
    // documento, cada uno puede cambiar `mano` y nada más — `palabra` tiene que
    // quedar exactamente como estaba. Sólo el anfitrión la mueve.
    //
    // Importa porque de ese campo depende el permiso de verdad: la Cloud
    // Function firma un token de **oyente** o de **el que habla** según lo que
    // diga `palabra`, y Agora no deja publicar voz a un oyente. Si esta regla
    // cede, la que cede es la del audio.
    match /salas/{canal} {

      function esAnfitrion() {
        return haEntrado()
          && exists(/databases/$(database)/documents/salas/$(canal))
          && get(/databases/$(database)/documents/salas/$(canal)).data.anfitrion == request.auth.uid;
      }

      function salaRazonable(d) {
        return d.keys().hasOnly(['nombre', 'anfitrion', 'abierta', 'desde', 'tipo', 'micLibre', 'campana', 'lectura',
                                 'padre', 'miembros', 'hasta', 'subgrupos'])
          && d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 60
          && d.abierta is bool
          && d.desde is number
          && d.tipo in ['devocional', 'llamada', 'subgrupo']
          // Un subgrupo: de qué devocional sale, quién entra y hasta cuándo.
          && (d.tipo != 'subgrupo' || ('padre' in d && 'miembros' in d))
          && (!('padre' in d) || (d.padre is string && d.padre.size() > 0 && d.padre.size() <= 64))
          && (!('miembros' in d) || (d.miembros is list && d.miembros.size() <= 30))
          && (!('hasta' in d) || d.hasta is number)
          // Y en el devocional, el reparto en marcha: como mucho 5 grupos.
          && (!('subgrupos' in d) || (
            d.subgrupos is map
            && d.subgrupos.keys().hasOnly(['desde', 'hasta', 'grupos', 'nombres'])
            && d.subgrupos.desde is number
            && d.subgrupos.hasta is number
            && d.subgrupos.grupos is list && d.subgrupos.grupos.size() >= 1 && d.subgrupos.grupos.size() <= 5
            && d.subgrupos.nombres is map && d.subgrupos.nombres.size() <= 60))
          // Micrófonos libres. Vive en la sala y no en cada ficha porque es una
          // decisión del anfitrión sobre todos, y la sala sólo la escribe él.
          && (!('micLibre' in d) || d.micLibre is bool)
          // La campana del final: un instante y si está encendida. También del
          // anfitrión, porque suena en el móvil de todos.
          && (!('campana' in d) || (
            d.campana is map
            && d.campana.keys().hasOnly(['cuando', 'activa'])
            && d.campana.cuando is number
            && d.campana.activa is bool))
          // La lectura por turnos: qué día del plan, qué trozo va, en qué
          // puesto de la lista está y quién lo lee. La lleva el anfitrión (y
          // el lector de turno, para decir «terminé»: ver abajo).
          && (!('lectura' in d) || (
            d.lectura is map
            && d.lectura.keys().hasOnly(['plan', 'dia', 'trozo', 'total', 'puesto', 'lector', 'lectorUid', 'desde'])
            && d.lectura.plan is string && d.lectura.plan.size() <= 40
            && d.lectura.dia is int && d.lectura.dia >= 1 && d.lectura.dia <= 366
            && d.lectura.trozo is int && d.lectura.trozo >= 0 && d.lectura.trozo <= 200
            // Cuántos trozos tiene: lo fija el anfitrión al empezar, para que
            // todos sepan a la vez cuándo se acaba.
            && (!('total' in d.lectura) || (d.lectura.total is int && d.lectura.total >= 1 && d.lectura.total <= 200
              // Y el trozo no pasa del final: «igual al total» es «se acabó».
              && d.lectura.trozo <= d.lectura.total))
            && d.lectura.puesto is int && d.lectura.puesto >= -1 && d.lectura.puesto <= 200
            && d.lectura.lector is string && d.lectura.lector.size() <= 40
            && d.lectura.lectorUid is string && d.lectura.lectorUid.size() <= 128
            && d.lectura.desde is number));
      }

      // La lee cualquiera que haya entrado: hace falta para saber si la sala
      // está abierta antes de pedir permiso de entrada.
      allow read: if haEntrado();

      // Abrir una sala **sólo quien modera**, y no por desconfianza: cada minuto
      // de voz que se abre aquí lo paga Alex en Agora. Cualquiera con una cuenta
      // podría abrir salas toda la noche y vaciar el saldo sin que nadie se
      // entere hasta el recibo.
      //
      // Se reutiliza la lista de `moderadores/{uid}`, que ya existe, no se puede
      // leer desde la app y se da de alta a mano desde la consola. Cuando haya
      // más anfitriones que Alex, esto es lo que hay que aflojar — y conviene
      // que sea una decisión, no un descuido.
      allow create: if esModerador()
        && request.resource.data.anfitrion == request.auth.uid
        && salaRazonable(request.resource.data);
      // Cerrarla, renombrarla: su anfitrión. Nadie puede quedarse con la sala
      // de otro: el anfitrión no se puede cambiar.
      allow update: if esElMismo(resource.data.anfitrion)
        && request.resource.data.anfitrion == resource.data.anfitrion
        && salaRazonable(request.resource.data);
      // Y REABRIRLA quien modera, si está cerrada o pasó su vida (4 h): la
      // reunión del devocional usa siempre el mismo canal, y la de ayer se
      // quedaba cerrada para siempre (el portero no deja entrar a una sala
      // cerrada, y sólo su anfitrión de ayer podía reescribirla). Se reescribe
      // entera, con quien la abre de anfitrión.
      //
      // Cerrada, sí, pero sólo si su anfitrión ya no está dentro: si no, un
      // moderador podía cerrar la reunión viva de otro y reabrirla como suya.
      allow update: if esModerador()
        && resource.data.tipo == 'devocional'
        && (request.time.toMillis() - resource.data.desde > 4 * 3600 * 1000
          || (resource.data.abierta == false
            && !exists(/databases/$(database)/documents/salas/$(canal)/dentro/$(resource.data.anfitrion))))
        && request.resource.data.anfitrion == request.auth.uid
        && request.resource.data.abierta == true
        && request.resource.data.tipo == 'devocional'
        && salaRazonable(request.resource.data);
      // Y CERRARLA, cualquier moderador: una sala que su anfitrión olvidó
      // abierta —se le apagó el móvil— sigue facturando en Agora hasta que
      // alguien la cierre. Sólo `abierta`, y sólo a false: nada más se toca.
      allow update: if esModerador()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['abierta'])
        && request.resource.data.abierta == false;
      // Y el que está leyendo dice «terminé»: pasa al trozo SIGUIENTE y a
      // nada más. Sin esto, en cada párrafo el anfitrión tenía que tocar el
      // botón mientras lee otro — y es justo el que tiene las manos ocupadas.
      //
      // Y se lo pasa a quien de verdad sigue: el de ese puesto en el orden de
      // lectura, con su cuenta, y dentro de la sala. O a nadie (se acabó, o no
      // queda quien lea: entonces reasigna el anfitrión). Sin esto, el lector
      // podía pasárselo a una cuenta ausente y la lectura se quedaba atascada.
      function pasaAQuienSigue(l) {
        let lista = get(/databases/$(database)/documents/comunidad/voz/lectura/orden).data.lista;
        return (l.lectorUid == '' && l.lector == '')
          || (l.puesto >= 0 && l.puesto < lista.size()
            && lista[l.puesto].id == l.lector
            && lista[l.puesto].get('uid', '') == l.lectorUid
            && exists(/databases/$(database)/documents/salas/$(canal)/dentro/$(l.lectorUid))
            // Y que sea de la comunidad (quien se salió ya no ve el texto), o
            // el anfitrión, que modera y lo lee aunque no esté apuntado.
            && (exists(/databases/$(database)/documents/comunidad/voz/miembros/$(l.lectorUid))
              || l.lectorUid == resource.data.anfitrion));
      }
      allow update: if haEntrado()
        && resource.data.get('lectura', null) != null
        && resource.data.lectura.get('lectorUid', '') == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lectura'])
        && request.resource.data.lectura.plan == resource.data.lectura.plan
        && request.resource.data.lectura.dia == resource.data.lectura.dia
        && request.resource.data.lectura.get('total', 0) == resource.data.lectura.get('total', 0)
        && request.resource.data.lectura.trozo == resource.data.lectura.trozo + 1
        && salaRazonable(request.resource.data)
        && pasaAQuienSigue(request.resource.data.lectura);
      allow delete: if esElMismo(resource.data.anfitrion);

      // ------------------------------------------------------ quién está dentro
      match /dentro/{quien} {
        function dentroRazonable(d) {
          return d.keys().hasOnly(['nombre', 'usuario', 'foto', 'entro', 'mano', 'palabra', 'racha', 'faltas', 'silenciado', 'escucha'])
            && d.nombre is string && d.nombre.size() <= 40
            && d.usuario is string && d.usuario.size() <= 20
            && (!('foto' in d) || (d.foto is string && d.foto.size() <= 60000))
            && d.entro is number
            && d.mano is bool
            && d.palabra is bool
            // La racha 🔥 y las faltas 😢 del devocional, copiadas de su
            // asistencia al entrar para que los demás las vean en la sala.
            && (!('racha' in d) || (d.racha is int && d.racha >= 0 && d.racha <= 10000))
            && (!('faltas' in d) || (d.faltas is int && d.faltas >= 0 && d.faltas <= 10000))
            // El micrófono cerrado por el anfitrión. Como `palabra`: sólo él.
            && (!('silenciado' in d) || d.silenciado is bool)
            // «Hoy sólo escucho» 👂: es de cada uno, y la lectura por turnos se
            // lo salta. En el grupo de WhatsApp es el 👂🏻 de la lista.
            && (!('escucha' in d) || d.escucha is bool);
        }

        // Todos ven la lista: es una reunión, no una sala a oscuras.
        allow read: if haEntrado();

        // Quien entra lo hace con SU nombre, SU usuario y SU foto: los de su
        // perfil. Cuesta una lectura, sólo al entrar. Sin esto cualquiera
        // aparecía en la sala con el nombre y la foto de otro.
        function esMiFicha(d) {
          let p = get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
          return d.nombre == p.nombre
            && d.usuario == p.usuario
            && (!('foto' in d) || d.foto == p.get('foto', ''));
        }

        // Un subgrupo es de sus miembros (y de su anfitrión, que entra a
        // escuchar). Una sala sin lista de miembros es de todos.
        function puedeEntrarAqui() {
          let s = get(/databases/$(database)/documents/salas/$(canal)).data;
          return (s.get('miembros', null) == null
              || request.auth.uid in s.miembros
              || s.anfitrion == request.auth.uid)
            // Y a quien echaron del devocional, tampoco en sus grupos.
            && (s.get('padre', '') == ''
              || !exists(/databases/$(database)/documents/salas/$(s.padre)/expulsados/$(request.auth.uid)));
        }

        // Entrar es a nombre propio, en silencio, y si no te han expulsado.
        allow create: if esElMismo(quien)
          && puedeEntrarAqui()
          && dentroRazonable(request.resource.data)
          && esMiFicha(request.resource.data)
          && request.resource.data.palabra == false
          && request.resource.data.get('silenciado', false) == false
          && !exists(/databases/$(database)/documents/salas/$(canal)/expulsados/$(quien));

        // Después de entrar, cada uno mueve SÓLO su mano: ni la palabra ni el
        // silencio (los da el anfitrión) ni el nombre o la foto. Y el
        // anfitrión mueve sólo la palabra, la mano y el silencio, pasando por
        // la misma validación: la rama del anfitrión no es un cheque en blanco.
        allow update: if (
            esElMismo(quien)
            && dentroRazonable(request.resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mano', 'escucha'])
          ) || (
            esAnfitrion()
            && dentroRazonable(request.resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['palabra', 'mano', 'silenciado'])
          );

        // Salirse, o que el anfitrión te saque.
        allow delete: if esElMismo(quien) || esAnfitrion();
      }

      // ------------------------------------------------------------ los «me gusta»
      //
      // Alex, 28-09-2026: «mientras alguien habla, debe estar la opción de darle
      // me gusta y de agregar». Uno por pareja y sala (`{de}_{a}`): se da o se
      // quita, y nadie llena la sala de corazones a toques. Sólo a nombre
      // propio, y a otro.
      //
      // Y sólo entre quienes están DENTRO de la sala abierta, y de esta sesión
      // (`sesion` = el `desde` de la sala): un expulsado o quien no está no
      // puede llenar la sala de corazones, y los de ayer no cuentan hoy. Lo leen
      // sólo los de dentro (y quien la lleva): quién le dio «me gusta» a quién
      // no es de nadie más.
      match /gustos/{id} {
        function dentroAqui(uid) {
          return exists(/databases/$(database)/documents/salas/$(canal)/dentro/$(uid));
        }
        function gustoRazonable(d) {
          let sala = get(/databases/$(database)/documents/salas/$(canal)).data;
          return d.keys().hasOnly(['de', 'a', 'cuando', 'sesion'])
            && d.de == request.auth.uid
            && d.a is string && d.a.size() > 0 && d.a.size() <= 128
            && d.a != request.auth.uid
            && d.cuando is number
            && d.sesion == sala.desde
            && sala.abierta == true
            && id == request.auth.uid + '_' + d.a
            && dentroAqui(request.auth.uid)
            && dentroAqui(d.a);
        }
        allow read: if haEntrado() && (dentroAqui(request.auth.uid) || esAnfitrion() || esModerador());
        // Crear, y también reescribir el propio (volver a darlo, o el de ayer).
        allow create: if haEntrado() && gustoRazonable(request.resource.data);
        allow update: if haEntrado() && resource.data.de == request.auth.uid && gustoRazonable(request.resource.data);
        allow delete: if haEntrado() && (resource.data.de == request.auth.uid || esAnfitrion());
      }

      // --------------------------------------------------------- los expulsados
      //
      // Se leen porque el cliente tiene que poder decirle a alguien por qué no
      // entra, en vez de dejarle mirando una sala que no carga.
      match /expulsados/{quien} {
        // Cada uno lee si está fuera (el portero lo lee con su token); la
        // lista, sólo el anfitrión. Quién fue expulsado de un devocional es
        // una decisión disciplinaria, no un dato para cualquiera con cuenta.
        allow get: if esElMismo(quien) || esAnfitrion();
        allow list: if esAnfitrion();
        allow write: if esAnfitrion();
      }
    }


    // ------------------------------------------------------- la comunidad de voz
    //
    // Quién se apuntó a que le suene el móvil cuando el anfitrión llame.
    //
    // **Esto es un espejo, no el interruptor.** Lo que hace sonar un móvil es
    // que él mismo se suscribió al tema `devocional` de Firebase; eso pasa en
    // el teléfono y aquí no se ve. Esta lista existe para que cada uno vea si
    // está y para que quien modera pueda contar cuántos son. Si un día esta
    // lista y el tema se desincronizan, lo que manda es el tema.
    //
    // Cada uno escribe y borra sólo lo suyo. Leer lo propio, cualquiera; **la
    // lista entera, sólo quien modera**: quién está apuntado a un grupo de
    // oración es cosa de cada uno, no un dato público.
    match /comunidad/voz/miembros/{uid} {
      // Desde la 6.27, el token de avisos de SU móvil, cuándo lo dejó y con
      // qué versión: el portero llama móvil por móvil y así sabe a cuál no le
      // llegó (un token por aparato en `moviles`; el tema va además para las
      // apps viejas). Lo ven él y quien modera (quien llama), nadie más.
      // Una entrada de `moviles`: su token, cuándo y con qué versión. Las reglas
      // no recorren mapas; con tres como mucho, se miran una a una.
      function movilRazonable(v) {
        return v is map && v.keys().hasOnly(['token', 'en', 'version'])
          && v.token is string && v.token.size() >= 20 && v.token.size() <= 400
          && v.en is number
          && (!('version' in v) || (v.version is string && v.version.size() <= 20));
      }
      function miembroRazonable(d) {
        return d.keys().hasOnly(['nombre', 'usuario', 'desde', 'token', 'tokenEn', 'version', 'moviles'])
          && d.nombre is string && d.nombre.size() <= 40
          && d.usuario is string && d.usuario.size() <= 20
          && d.desde is number
          && (!('token' in d) || (d.token is string && d.token.size() >= 20 && d.token.size() <= 400))
          && (!('tokenEn' in d) || d.tokenEn is number)
          && (!('version' in d) || (d.version is string && d.version.size() <= 20))
          // Un token por aparato (su móvil y su tableta), como mucho tres.
          && (!('moviles' in d) || (d.moviles is map && d.moviles.size() <= 3
            && (d.moviles.size() < 1 || movilRazonable(d.moviles.values()[0]))
            && (d.moviles.size() < 2 || movilRazonable(d.moviles.values()[1]))
            && (d.moviles.size() < 3 || movilRazonable(d.moviles.values()[2]))));
      }
      allow get: if esElMismo(uid);
      allow list: if esModerador();
      allow create, update: if esElMismo(uid) && miembroRazonable(request.resource.data);
      allow delete: if esElMismo(uid);
    }

    // ------------------------------------------------------- la asistencia
    //
    // Quién vino al devocional, su racha (días seguidos) y sus faltas (del
    // último mes). Alex, 28-09-2026: «debo tener un control de asistencias e
    // inasistencias». Cada móvil apunta lo suyo al entrar a la sala; la lista
    // entera la ve quien modera. Los dos números se copian a `dentro/{uid}`
    // al entrar, que es donde los ven los demás.
    // ------------------------------------------------------ el orden de lectura
    //
    // La lista de quién lee, en orden, como el «ORDEN DE LECTURA BÍBLICA DE
    // HOY» del grupo: cada entrada con su nombre y, si ya está en la app, su
    // cuenta. Y el «ancla» del comentario: qué puesto comentó qué día; desde
    // ahí avanza uno por día y da la vuelta, que es como se hace en el grupo.
    // La escribe quien modera; la leen la comunidad y quien modera.
    match /comunidad/voz/lectura/{doc} {
      function ordenRazonable(d) {
        return d.keys().hasOnly(['lista', 'ancla', 'actualizado'])
          && d.lista is list && d.lista.size() <= 80
          && (d.lista.size() == 0 || (d.lista[0] is map && d.lista[d.lista.size() - 1] is map))
          && d.ancla is map && d.ancla.keys().hasOnly(['fecha', 'puesto'])
          && d.ancla.fecha is string && d.ancla.fecha.size() == 10
          && d.ancla.puesto is int && d.ancla.puesto >= 0
          && d.actualizado is int;
      }
      allow read: if esModerador() || esMiembro();
      allow write: if esModerador() && doc == 'orden' && ordenRazonable(request.resource.data);
    }

    // ------------------------------------------------- el archivo de devocionales
    //
    // «Caminemos con la Palabra», día a día: lo que Alex manda al grupo cada
    // mañana. Lleva el texto bíblico completo (RVR1960, que tiene derechos),
    // así que se comparte como hoy en WhatsApp: SÓLO con la comunidad. Lo sube
    // la cuenta de servicio (scripts/devocionales/subir.mjs); desde la app no
    // se escribe.
    match /devocionales/{plan}/dias/{dia} {
      // El día pegado desde la app: el Bloque 1 ya partido en trozos. Se
      // comprueba la forma, no el contenido: lo escribe quien modera.
      function diaRazonable(d) {
        return d.keys().hasOnly(['dia', 'fecha', 'tema', 'capitulos', 'trozos', 'aprendi', 'subido'])
          && d.dia is int && d.dia >= 1 && d.dia <= 366 && string(d.dia) == dia
          && d.fecha is string && d.fecha.size() == 10
          && d.tema is string && d.tema.size() <= 300
          && d.capitulos is list && d.capitulos.size() <= 40
          && d.trozos is list && d.trozos.size() >= 1 && d.trozos.size() <= 200
          // Las reglas no recorren listas; el primero y el último, al menos,
          // tienen que ser trozos. (La app además se salta lo que no lo sea.)
          && d.trozos[0] is map && d.trozos[d.trozos.size() - 1] is map
          && (!('aprendi' in d) || (d.aprendi is string && d.aprendi.size() <= 20000))
          && d.subido is int;
      }
      allow read: if esModerador() || esMiembro();
      // Pegar o corregir el devocional del día: quien modera, sólo en el plan
      // de la comunidad. Borrar, nadie desde la app.
      allow create, update: if esModerador()
        && plan == 'caminemos-2026'
        && diaRazonable(request.resource.data);
      allow delete: if false;
    }

    match /comunidad/voz/asistencia/{uid} {
      function asistenciaRazonable(d) {
        return d.keys().hasOnly(['nombre', 'usuario', 'dias', 'racha', 'faltas', 'ultimo'])
          && d.nombre is string && d.nombre.size() <= 40
          && d.usuario is string && d.usuario.size() <= 20
          && d.dias is list && d.dias.size() <= 120
          && d.racha is int && d.racha >= 0 && d.racha <= 10000
          && d.faltas is int && d.faltas >= 0 && d.faltas <= 10000
          && d.ultimo is string && d.ultimo.size() == 10;
      }
      allow get: if esElMismo(uid) || esModerador();
      allow list: if esModerador();
      allow create, update: if esElMismo(uid) && asistenciaRazonable(request.resource.data);
      allow delete: if esElMismo(uid);
    }

    // --------------------------------------------------------------- el muro
    //
    // Las notas que alguien decidió publicar. **Nada llega aquí sin que su
    // dueño lo mande**: la app las escribe de una en una y sólo al tocar
    // «publicar».
    //
    // Se leen sin haber entrado, y es a propósito: Alex lo pidió así —«lo
    // público lo puede ver todo el mundo, amigos o no»— y la app entera
    // funciona sin cuenta. Exigir cuenta para leer dejaría el muro en blanco
    // justo para quien abre la app por primera vez, que es precisamente a
    // quien hay que animar.
    //
    // Escribir sí exige cuenta, y sólo a nombre propio: el `uid` del documento
    // tiene que ser el de quien lo manda, y no puede cambiar después. Sin eso,
    // cualquiera podría publicar firmando con el nombre de otro.
    match /notas/{id} {
      function notaRazonable(d) {
        return d.keys().hasOnly(['uid', 'nombre', 'usuario', 'texto', 'momento'])
          && d.texto is string && d.texto.size() > 0 && d.texto.size() <= 2000
          && d.nombre is string && d.nombre.size() <= 40
          && d.usuario is string && d.usuario.size() <= 20
          && d.momento is number;
      }

      allow read: if true;
      allow create: if esElMismo(request.resource.data.uid)
        && notaRazonable(request.resource.data);
      allow update: if esElMismo(resource.data.uid)
        && request.resource.data.uid == resource.data.uid
        && notaRazonable(request.resource.data);
      // Retirar lo propio, siempre. Lo ajeno, sólo quien modera.
      allow delete: if esElMismo(resource.data.uid) || esModerador();
    }

    // ------------------------------------------------------- frases favoritas
    //
    // Las frases que cada uno enseña en su perfil. Alex: «que se puedan
    // publicar también, cada quien decide».
    //
    // **La clave del documento lleva el uid delante** (`uid.huella`) y por eso
    // no se valida aquí como se valida el resto: el id de una frase guardada
    // es la huella de su texto, y dos hermanos que guarden el mismo versículo
    // —salen del mismo banco, va a pasar a diario— tendrían el mismo id. Con
    // el texto por clave, el segundo en publicar chocaría con el documento del
    // primero y estas reglas se lo negarían sin que él pudiera entenderlo.
    //
    // Lo que autoriza es el campo `uid`, como en el muro. La clave sólo separa.
    match /frases/{id} {
      function fraseRazonable(d) {
        return d.keys().hasAll(['uid', 'nombre', 'usuario', 'texto', 'cuando'])
          && d.keys().hasOnly(['uid', 'nombre', 'usuario', 'texto', 'fuente', 'cuando'])
          && d.texto is string && d.texto.size() > 0 && d.texto.size() <= 2000
          && d.nombre is string && d.nombre.size() <= 40
          && d.usuario is string && d.usuario.size() <= 20
          && (!('fuente' in d) || (d.fuente is string && d.fuente.size() <= 80))
          && d.cuando is number;
      }

      allow read: if true;
      allow create: if esElMismo(request.resource.data.uid)
        && fraseRazonable(request.resource.data);
      allow update: if esElMismo(resource.data.uid)
        && request.resource.data.uid == resource.data.uid
        && fraseRazonable(request.resource.data);
      allow delete: if esElMismo(resource.data.uid) || esModerador();
    }

    // ------------------------------------------------- avisos de fallos
    //
    // Un buzón, como las denuncias: se deja algo dentro y no se vuelve a abrir
    // desde la app. Se leen con `node scripts/fallos.mjs`.
    //
    // **No exige haber entrado, y es a propósito.** Lo intuitivo sería pedir
    // cuenta para evitar basura, pero los dos peores fallos de este proyecto
    // han sido fallos de *entrar*: el login que rebotaba y el registro que no
    // terminaba. Quien más necesita avisar es justo el que no puede entrar, y
    // exigirle cuenta es dejarle sin voz precisamente cuando el fallo es grave.
    //
    // El precio es que alguien podría dejar ruido aquí. Se paga: el ruido se
    // borra en un minuto, y un fallo que nadie pudo contar puede durar meses.
    match /fallos/{id} {
      allow create: if request.resource.data.keys().hasOnly(['texto', 'parte', 'cuando'])
        && request.resource.data.texto is string
        && request.resource.data.texto.size() > 0
        && request.resource.data.texto.size() <= 2000
        && request.resource.data.parte is string
        && request.resource.data.parte.size() <= 4000
        && request.resource.data.cuando is number;
      allow read, update, delete: if false;

      // Las capturas van de una en una: tres dentro del mismo documento
      // pasarían del megabyte que admite Firestore y se perdería el aviso
      // entero, con el texto dentro, que es lo que de verdad importa.
      match /capturas/{cual} {
        // El mismo tope que encoge la app (TOPE_IMAGEN en logica/fallos.ts):
        // si se cambia uno se cambia el otro. Lo que de verdad frenaría a
        // quien quisiera llenar la base sin cuenta no son estas reglas sino
        // App Check; queda anotado en la bitácora.
        allow create: if request.resource.data.keys().hasOnly(['imagen'])
          && request.resource.data.imagen is string
          && request.resource.data.imagen.size() > 0
          && request.resource.data.imagen.size() <= 700000;
        allow read, update, delete: if false;
      }
    }

    // ------------------------------------------------------------ denuncias
    //
    // Un buzón de una sola dirección: se deja algo dentro y no se vuelve a
    // abrir desde la app. Nadie puede leer las denuncias de nadie —ni las
    // suyas—, ni cambiarlas, ni borrarlas. Se leen desde la consola.
    match /denuncias/{id} {
      allow create: if haEntrado()
        && request.resource.data.de == request.auth.uid
        && request.resource.data.nota is string
        && request.resource.data.motivo is string
        && request.resource.data.motivo.size() <= 200;
      allow read, update, delete: if false;
    }

    // Quién modera.
    //
    // **Cada uno puede leer sólo el suyo, y nadie puede escribir ninguno.** Se
    // dan de alta con `node scripts/moderador.mjs poner correo@…`, que va con
    // la cuenta de servicio y se salta estas reglas.
    //
    // Leer el propio hace falta, y esto no estaba: sin poder preguntar «¿soy
    // moderador?», la app no sabía si enseñar el botón de retirar, así que el
    // permiso existía en el servidor y **no había manera de usarlo**. Un
    // permiso sin botón es un permiso que no existe.
    //
    // Que sea sólo el propio importa: nadie puede sacar la lista de quién
    // modera, ni comprobar si tal persona lo es.
    //
    // ── Y quién manda (28-09-2026) ───────────────────────────────────────
    //
    // Alex, sobre el timbre: «sólo yo (o alguno de los otros administradores
    // que yo señale)». Dos rangos en la misma lista: el **dueño** (`dueno:
    // true`, uno solo, se pone con `node scripts/moderador.mjs dueño
    // correo@…`) y los moderadores que él nombra desde la app. Un moderador
    // puede llamar, abrir salas y retirar lo ajeno; **sólo el dueño nombra y
    // quita**, y a él no lo quita nadie. Así ningún moderador puede nombrar a
    // un tercero ni dejar al dueño fuera de su propia comunidad.
    //
    // `dueno` va sin ñ porque el lenguaje de reglas no admite ñ en los
    // nombres de campo. Nada se puede editar: la única manera de hacerse
    // dueño es la cuenta de servicio, desde este PC.
    function esDueno() {
      return haEntrado()
        && get(/databases/$(database)/documents/moderadores/$(request.auth.uid))
          .data.get("dueno", false) == true;
    }
    function moderadorRazonable(d) {
      return d.keys().hasOnly(["nombre", "usuario", "puestoPor", "desde"])
        && d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 60
        && d.usuario is string && d.usuario.size() >= 3 && d.usuario.size() <= 20
        && d.puestoPor == request.auth.uid
        && d.desde is int;
    }
    match /moderadores/{uid} {
      allow get: if esElMismo(uid) || esDueno();
      allow list: if esDueno();
      // Nombrar: sólo el dueño, nunca a sí mismo, y sin poder crear otro
      // dueño: `moderadorRazonable` no admite el campo `dueno`.
      allow create: if esDueno()
        && uid != request.auth.uid
        && moderadorRazonable(request.resource.data);
      allow update: if false;
      // Quitar: sólo el dueño, y al dueño no lo quita nadie, ni él mismo.
      allow delete: if esDueno()
        && uid != request.auth.uid
        && resource.data.get("dueno", false) != true;
    }

    // ------------------------------------------------------ nombres de usuario
    //
    // Una colección aparte solo para que los nombres sean únicos. Firestore no
    // tiene índices únicos: la unicidad se consigue haciendo del nombre la
    // **clave del documento** y prohibiendo sobrescribir uno que ya existe.
    match /handles/{usuario} {
      allow read: if haEntrado();
      // Solo se puede crear si no existe —eso lo garantiza `create`— y
      // apuntando a uno mismo.
      allow create: if haEntrado()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid'])
        && usuario.matches('^[a-z0-9._]+$')
        && usuario.size() >= 3 && usuario.size() <= 20;
      // Cambiar de nombre es borrar el viejo y crear el nuevo. Nadie puede
      // tocar el de otro.
      allow delete: if haEntrado() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // Todo lo que no esté nombrado arriba queda cerrado. No se toca.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
