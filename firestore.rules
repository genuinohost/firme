rules_version = '2';

// ============================================================================
// Las reglas de Genuino.
//
// Esto NO es una capa de adorno sobre la app: es lo único que separa los datos
// de las personas de cualquiera con una conexión a internet. La app cliente se
// puede desmontar y reescribir en una tarde; estas reglas no. Todo lo que aquí
// no se prohíba, está permitido para todo el mundo.
//
// ── La línea, y dónde se movió ────────────────────────────────────────────
//
// Hasta el 17 de septiembre de 2026 aquí ponía que **el diario, las notas y
// los repasos no subían nunca**, y pedía que quien lo cambiara viniera a
// borrar el párrafo a mano. Esto es esa mano.
//
// Lo cambió Alex, el dueño de la app, con estas palabras: «las notas en el
// diario y exámenes deben tener la opción de pública o privada. Lo público lo
// puede ver todo el mundo, amigos o no». Queda escrito aquí, y no sólo en un
// registro de cambios, para que dentro de un año se sepa quién lo pidió.
//
// **La regla nueva:** nada de lo que se escribe llega a este servidor salvo la
// nota concreta en la que su dueño tocó «publicar». Todo nace privado, lo que
// ya estaba escrito sigue privado, y despublicar borra el documento — no lo
// esconde. Ni el plan del que viene una nota ni cómo acabó aquel día se
// publican jamás: eso cuenta la batalla de alguien aunque su texto no la
// cuente.
//
// El diario entero y los repasos de la noche siguen sin tener colección aquí, y
// siguen sin poder tenerla.
//
// ── La segunda vez que se movió: el respaldo ───────────────────────────────
//
// El 24 de septiembre de 2026, Alex: «los datos básicos deberían estar en una
// nube, porque no todo el mundo va a estar pendiente de exportar una copia».
// Tenía razón, y era un fallo de diseño: el primer hermano que cambiara de
// teléfono perdía su rutina entera.
//
// Así que **la rutina y los registros sí suben ahora**, en `usuarios/{uid}/
// respaldo/rutina`, y sólo los lee su dueño. Lo que no sube, y lo que estas
// reglas impiden que suba nunca, está escrito abajo en esa sección.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function haEntrado() {
      return request.auth != null;
    }

    function esElMismo(uid) {
      return haEntrado() && request.auth.uid == uid;
    }

    // Quién puede retirar lo que escribió otro.
    //
    // La lista vive en `moderadores/{uid}` y **no se puede leer ni escribir
    // desde la app**: se pone a mano desde la consola de Firebase. `exists()`
    // funciona igual, porque las reglas no se aplican a sí mismas.
    //
    // Existe porque Google Play no deja publicar una app donde unos usuarios
    // leen lo que escriben otros si nadie puede quitar lo que esté mal.
    function esModerador() {
      return haEntrado()
        && exists(/databases/$(database)/documents/moderadores/$(request.auth.uid));
    }

    // Un perfil que no cabe en esto es un perfil que trae basura o un intento
    // de usar la base como almacén ajeno.
    function perfilRazonable(d) {
      return d.nombre is string && d.nombre.size() >= 2 && d.nombre.size() <= 40
        && d.usuario is string && d.usuario.size() >= 3 && d.usuario.size() <= 20
        && d.usuario.matches('^[a-z0-9._]+$')
        && (!('ciudad' in d) || (d.ciudad is string && d.ciudad.size() <= 60))
        && (!('pais' in d) || (d.pais is string && d.pais.size() <= 60))
        && (!('versiculo' in d) || (d.versiculo is string && d.versiculo.size() <= 300))
        && (!('cita' in d) || (d.cita is string && d.cita.size() <= 60))
        // La foto va **dentro del perfil**, encogida a 192 píxeles: unos diez
        // kilobytes. Así no hace falta montar un almacén de archivos, ni
        // pagarlo, ni escribir reglas para él, ni acordarse de borrar la foto
        // cuando alguien borra su cuenta — se va con el perfil, porque es el
        // perfil. El tope deja sitio de sobra para eso y muy poco para que a
        // nadie se le ocurra usar esto como disco duro.
        && (!('foto' in d) || (d.foto is string && d.foto.size() <= 60000))
        // Las cifras que cada uno decide enseñar a sus hermanos. Se validan
        // como números y con un techo: no para desconfiar de la app, sino
        // porque **estas reglas son lo único que sigue en pie si alguien no
        // usa la app** y escribe contra la base directamente.
        && (!('muestraRachas' in d) || d.muestraRachas is bool)
        && (!('racha' in d) || (d.racha is int && d.racha >= 0 && d.racha <= 100000))
        && (!('diasEnPie' in d) || (d.diasEnPie is int && d.diasEnPie >= 0 && d.diasEnPie <= 100000))
        && (!('cumplidos' in d) || (d.cumplidos is int && d.cumplidos >= 0 && d.cumplidos <= 10000000))
        // El nombre en minúsculas, sólo para poder buscar.
        && (!('busca' in d) || (d.busca is string && d.busca.size() <= 60));
    }

    // ------------------------------------------------------------- perfiles
    //
    // Un perfil lo puede leer cualquiera que haya entrado: si no, no habría
    // forma de buscar a un hermano por su nombre de usuario para agregarlo.
    // Por eso **en el perfil no va nada que no se pueda enseñar**: ni correo,
    // ni dirección, ni nada de lo que se escribe en la app.
    match /usuarios/{uid} {
      allow read: if haEntrado();
      allow create, update: if esElMismo(uid) && perfilRazonable(request.resource.data);
      allow delete: if esElMismo(uid);

      // ------------------------------------------- lo que sólo ven los suyos
      //
      // **El WhatsApp no va en el perfil.** El perfil lo puede leer cualquiera
      // que haya entrado —hace falta para poder buscar a un hermano por su
      // nombre—, y un número de teléfono ahí lo recoge cualquiera con una
      // cuenta y un rato libre.
      //
      // Así que vive aparte, y aquí se comprueba de verdad que quien lo pide es
      // un hermano **ya aceptado**: se mira en la lista de amigos del dueño si
      // existe el documento de quien pregunta y si está en «aceptada». Cuesta
      // una lectura más, y es exactamente lo que hay que pagar por esto.
      match /privado/{cual} {
        allow read: if esElMismo(uid)
          || (
            haEntrado()
            && exists(/databases/$(database)/documents/usuarios/$(uid)/amigos/$(request.auth.uid))
            && get(/databases/$(database)/documents/usuarios/$(uid)/amigos/$(request.auth.uid)).data.estado == 'aceptada'
          );
        allow write: if esElMismo(uid)
          && (!('whatsapp' in request.resource.data)
              || (request.resource.data.whatsapp is string
                  && request.resource.data.whatsapp.size() <= 40));
      }

      // ----------------------------------------------------------- el respaldo
      //
      // La copia de la rutina, para que cambiar de teléfono no cueste la racha.
      //
      // **Sólo su dueño.** Ni los hermanos aceptados, que sí pueden leer
      // `privado`: ahí hay un número de teléfono para que le llamen, y aquí hay
      // el respaldo de alguien. No es un dato de su perfil, no se comparte con
      // nadie, y por eso la condición es la más corta de este archivo.
      //
      // **La lista de campos es la promesa, escrita donde se cumple.** El
      // diario (`notas`) no está en la lista, así que no cabe: no depende de
      // que la app se acuerde de quitarlo, ni de que nadie meta mañana otra vía
      // de subida. Si un día alguien intenta respaldar el diario, esto se lo
      // niega en el servidor.
      //
      // Lo que estas reglas **no** pueden vigilar es lo que va dentro de
      // `registros` y `planesRegistros`: las reglas no saben recorrer un mapa.
      // Que la excusa de cada día y las áreas donde alguien cayó se queden en
      // el móvil lo decide `src/logica/respaldoNube.ts`, en un solo sitio y a
      // propósito. Aquí queda dicho para que se sepa dónde mirar.
      match /respaldo/{cual} {
        allow read: if esElMismo(uid);
        allow write: if esElMismo(uid)
          && request.resource.data.keys().hasOnly([
            'version', 'planes', 'planesRegistros', 'rutina', 'tareas',
            'registros', 'motivos', 'ajustes', 'guardado'
          ])
          && request.resource.data.guardado is number;
      }

      // --------------------------------------------------------- bloqueados
      //
      // A quién no quiero volver a leer. Es asunto de uno y de nadie más: ni
      // siquiera el bloqueado puede saber que lo está, que es justo lo que
      // hace que bloquear no dé miedo.
      match /bloqueados/{otro} {
        allow read, write: if esElMismo(uid);
      }

      // --------------------------------------------------------- amistades
      //
      // Cada lado guarda su propia copia. Parece redundante y no lo es: es lo
      // que permite que las reglas sean simples y que nadie pueda escribir en
      // la lista de otro salvo para una cosa muy concreta — dejar ahí una
      // solicitud **a nombre de sí mismo**.
      //
      // Sin esa restricción, cualquiera podría meterse en la lista de amigos
      // de cualquiera, o borrar las amistades de otro.
      match /amigos/{otro} {
        allow read: if esElMismo(uid);
        allow write: if esElMismo(uid);

        // Mandar una solicitud: escribir en la bandeja del otro, pero solo un
        // documento que habla de uno mismo y en estado «recibida».
        allow create: if esElMismo(otro)
          && request.resource.data.estado == 'recibida'
          && request.resource.data.keys().hasOnly(['estado', 'cuando', 'nombre', 'usuario', 'foto']);

        // Aceptar: el otro marca como aceptada la copia que tiene el primero.
        allow update: if esElMismo(otro)
          && request.resource.data.estado == 'aceptada'
          && resource.data.estado == 'enviada';

        // Deshacer una solicitud propia, o borrarse de la lista de alguien a
        // quien uno ya no quiere tener. Siempre sobre el documento de uno.
        allow delete: if esElMismo(otro);
      }
    }

    // ---------------------------------------------------------------- las salas
    //
    // El devocional en voz, y la llamada de dos. Son lo mismo con dos tamaños,
    // así que hay una sola colección.
    //
    // ── Aquí no viaja audio ───────────────────────────────────────────────
    //
    // Firestore sólo guarda **quién está dentro y quién tiene la palabra**. La
    // voz va por el SFU de Agora y no pasa por aquí ni queda grabada en ningún
    // sitio. Lo que hay en estos documentos es una lista de nombres.
    //
    // ── La regla que sostiene el devocional ───────────────────────────────
    //
    // **Nadie se da la palabra a sí mismo.** Treinta micrófonos abiertos no son
    // un devocional, son un ruido; así que se entra en silencio, se levanta la
    // mano, y el anfitrión da la palabra.
    //
    // Y eso **se cumple aquí, no por educación**: al actualizar su propio
    // documento, cada uno puede cambiar `mano` y nada más — `palabra` tiene que
    // quedar exactamente como estaba. Sólo el anfitrión la mueve.
    //
    // Importa porque de ese campo depende el permiso de verdad: la Cloud
    // Function firma un token de **oyente** o de **el que habla** según lo que
    // diga `palabra`, y Agora no deja publicar voz a un oyente. Si esta regla
    // cede, la que cede es la del audio.
    match /salas/{canal} {

      function esAnfitrion() {
        return haEntrado()
          && exists(/databases/$(database)/documents/salas/$(canal))
          && get(/databases/$(database)/documents/salas/$(canal)).data.anfitrion == request.auth.uid;
      }

      function salaRazonable(d) {
        return d.keys().hasOnly(['nombre', 'anfitrion', 'abierta', 'desde', 'tipo'])
          && d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 60
          && d.abierta is bool
          && d.desde is number
          && d.tipo in ['devocional', 'llamada'];
      }

      // La lee cualquiera que haya entrado: hace falta para saber si la sala
      // está abierta antes de pedir permiso de entrada.
      allow read: if haEntrado();
      allow create: if haEntrado()
        && request.resource.data.anfitrion == request.auth.uid
        && salaRazonable(request.resource.data);
      // Cerrarla, renombrarla. Nadie puede quedarse con la sala de otro: el
      // anfitrión no se puede cambiar.
      allow update: if esElMismo(resource.data.anfitrion)
        && request.resource.data.anfitrion == resource.data.anfitrion
        && salaRazonable(request.resource.data);
      allow delete: if esElMismo(resource.data.anfitrion);

      // ------------------------------------------------------ quién está dentro
      match /dentro/{quien} {
        function dentroRazonable(d) {
          return d.keys().hasOnly(['nombre', 'usuario', 'foto', 'entro', 'mano', 'palabra'])
            && d.nombre is string && d.nombre.size() <= 40
            && d.usuario is string && d.usuario.size() <= 20
            && (!('foto' in d) || (d.foto is string && d.foto.size() <= 60000))
            && d.entro is number
            && d.mano is bool
            && d.palabra is bool;
        }

        // Todos ven la lista: es una reunión, no una sala a oscuras.
        allow read: if haEntrado();

        // Entrar es a nombre propio, en silencio, y si no te han expulsado.
        allow create: if esElMismo(quien)
          && dentroRazonable(request.resource.data)
          && request.resource.data.palabra == false
          && !exists(/databases/$(database)/documents/salas/$(canal)/expulsados/$(quien));

        // Levantar la mano es lo propio. La palabra la da el anfitrión, y por
        // eso al tocar lo suyo `palabra` tiene que quedarse igual.
        allow update: if (
            esElMismo(quien)
            && dentroRazonable(request.resource.data)
            && request.resource.data.palabra == resource.data.palabra
          ) || esAnfitrion();

        // Salirse, o que el anfitrión te saque.
        allow delete: if esElMismo(quien) || esAnfitrion();
      }

      // --------------------------------------------------------- los expulsados
      //
      // Se leen porque el cliente tiene que poder decirle a alguien por qué no
      // entra, en vez de dejarle mirando una sala que no carga.
      match /expulsados/{quien} {
        allow read: if haEntrado();
        allow write: if esAnfitrion();
      }
    }


    // --------------------------------------------------------------- el muro
    //
    // Las notas que alguien decidió publicar. **Nada llega aquí sin que su
    // dueño lo mande**: la app las escribe de una en una y sólo al tocar
    // «publicar».
    //
    // Se leen sin haber entrado, y es a propósito: Alex lo pidió así —«lo
    // público lo puede ver todo el mundo, amigos o no»— y la app entera
    // funciona sin cuenta. Exigir cuenta para leer dejaría el muro en blanco
    // justo para quien abre la app por primera vez, que es precisamente a
    // quien hay que animar.
    //
    // Escribir sí exige cuenta, y sólo a nombre propio: el `uid` del documento
    // tiene que ser el de quien lo manda, y no puede cambiar después. Sin eso,
    // cualquiera podría publicar firmando con el nombre de otro.
    match /notas/{id} {
      function notaRazonable(d) {
        return d.keys().hasOnly(['uid', 'nombre', 'usuario', 'texto', 'momento'])
          && d.texto is string && d.texto.size() > 0 && d.texto.size() <= 2000
          && d.nombre is string && d.nombre.size() <= 40
          && d.usuario is string && d.usuario.size() <= 20
          && d.momento is number;
      }

      allow read: if true;
      allow create: if esElMismo(request.resource.data.uid)
        && notaRazonable(request.resource.data);
      allow update: if esElMismo(resource.data.uid)
        && request.resource.data.uid == resource.data.uid
        && notaRazonable(request.resource.data);
      // Retirar lo propio, siempre. Lo ajeno, sólo quien modera.
      allow delete: if esElMismo(resource.data.uid) || esModerador();
    }

    // ------------------------------------------------------- frases favoritas
    //
    // Las frases que cada uno enseña en su perfil. Alex: «que se puedan
    // publicar también, cada quien decide».
    //
    // **La clave del documento lleva el uid delante** (`uid.huella`) y por eso
    // no se valida aquí como se valida el resto: el id de una frase guardada
    // es la huella de su texto, y dos hermanos que guarden el mismo versículo
    // —salen del mismo banco, va a pasar a diario— tendrían el mismo id. Con
    // el texto por clave, el segundo en publicar chocaría con el documento del
    // primero y estas reglas se lo negarían sin que él pudiera entenderlo.
    //
    // Lo que autoriza es el campo `uid`, como en el muro. La clave sólo separa.
    match /frases/{id} {
      function fraseRazonable(d) {
        return d.keys().hasAll(['uid', 'nombre', 'usuario', 'texto', 'cuando'])
          && d.keys().hasOnly(['uid', 'nombre', 'usuario', 'texto', 'fuente', 'cuando'])
          && d.texto is string && d.texto.size() > 0 && d.texto.size() <= 2000
          && d.nombre is string && d.nombre.size() <= 40
          && d.usuario is string && d.usuario.size() <= 20
          && (!('fuente' in d) || (d.fuente is string && d.fuente.size() <= 80))
          && d.cuando is number;
      }

      allow read: if true;
      allow create: if esElMismo(request.resource.data.uid)
        && fraseRazonable(request.resource.data);
      allow update: if esElMismo(resource.data.uid)
        && request.resource.data.uid == resource.data.uid
        && fraseRazonable(request.resource.data);
      allow delete: if esElMismo(resource.data.uid) || esModerador();
    }

    // ------------------------------------------------- avisos de fallos
    //
    // Un buzón, como las denuncias: se deja algo dentro y no se vuelve a abrir
    // desde la app. Se leen con `node scripts/fallos.mjs`.
    //
    // **No exige haber entrado, y es a propósito.** Lo intuitivo sería pedir
    // cuenta para evitar basura, pero los dos peores fallos de este proyecto
    // han sido fallos de *entrar*: el login que rebotaba y el registro que no
    // terminaba. Quien más necesita avisar es justo el que no puede entrar, y
    // exigirle cuenta es dejarle sin voz precisamente cuando el fallo es grave.
    //
    // El precio es que alguien podría dejar ruido aquí. Se paga: el ruido se
    // borra en un minuto, y un fallo que nadie pudo contar puede durar meses.
    match /fallos/{id} {
      allow create: if request.resource.data.keys().hasOnly(['texto', 'parte', 'cuando'])
        && request.resource.data.texto is string
        && request.resource.data.texto.size() > 0
        && request.resource.data.texto.size() <= 2000
        && request.resource.data.parte is string
        && request.resource.data.parte.size() <= 4000
        && request.resource.data.cuando is number;
      allow read, update, delete: if false;

      // Las capturas van de una en una: tres dentro del mismo documento
      // pasarían del megabyte que admite Firestore y se perdería el aviso
      // entero, con el texto dentro, que es lo que de verdad importa.
      match /capturas/{cual} {
        allow create: if request.resource.data.keys().hasOnly(['imagen'])
          && request.resource.data.imagen is string
          && request.resource.data.imagen.size() <= 900000;
        allow read, update, delete: if false;
      }
    }

    // ------------------------------------------------------------ denuncias
    //
    // Un buzón de una sola dirección: se deja algo dentro y no se vuelve a
    // abrir desde la app. Nadie puede leer las denuncias de nadie —ni las
    // suyas—, ni cambiarlas, ni borrarlas. Se leen desde la consola.
    match /denuncias/{id} {
      allow create: if haEntrado()
        && request.resource.data.de == request.auth.uid
        && request.resource.data.nota is string
        && request.resource.data.motivo is string
        && request.resource.data.motivo.size() <= 200;
      allow read, update, delete: if false;
    }

    // Quién modera.
    //
    // **Cada uno puede leer sólo el suyo, y nadie puede escribir ninguno.** Se
    // dan de alta con `node scripts/moderador.mjs poner correo@…`, que va con
    // la cuenta de servicio y se salta estas reglas.
    //
    // Leer el propio hace falta, y esto no estaba: sin poder preguntar «¿soy
    // moderador?», la app no sabía si enseñar el botón de retirar, así que el
    // permiso existía en el servidor y **no había manera de usarlo**. Un
    // permiso sin botón es un permiso que no existe.
    //
    // Que sea sólo el propio importa: nadie puede sacar la lista de quién
    // modera, ni comprobar si tal persona lo es.
    match /moderadores/{uid} {
      allow read: if esElMismo(uid);
      allow write: if false;
    }

    // ------------------------------------------------------ nombres de usuario
    //
    // Una colección aparte solo para que los nombres sean únicos. Firestore no
    // tiene índices únicos: la unicidad se consigue haciendo del nombre la
    // **clave del documento** y prohibiendo sobrescribir uno que ya existe.
    match /handles/{usuario} {
      allow read: if haEntrado();
      // Solo se puede crear si no existe —eso lo garantiza `create`— y
      // apuntando a uno mismo.
      allow create: if haEntrado()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid'])
        && usuario.matches('^[a-z0-9._]+$')
        && usuario.size() >= 3 && usuario.size() <= 20;
      // Cambiar de nombre es borrar el viejo y crear el nuevo. Nadie puede
      // tocar el de otro.
      allow delete: if haEntrado() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // Todo lo que no esté nombrado arriba queda cerrado. No se toca.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
